# --- NVIDIA NIM (primary LLM provider) ---
# Get your API key from: https://build.nvidia.com/
# Free tier is 40 RPM; nim_client throttles to stay under it.
NVIDIA_NIM_API_KEY=nvapi-your-key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Telegram (delivery + failure alerts) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- Optional extras ---
PERPLEXITY_API_KEY=pplx-your-key

# --- Feature toggles (defaults shown) ---
# USE_DYNAMIC_TOPICS=true    # fetch trending headlines instead of static DAILY_TOPICS
# HUMANIZE=false             # run the humanizer pass and save both versions
# POST_SUBSTACK=false        # auto-publish articles as Substack drafts
# POST_X=false               # auto-post a thread to X
