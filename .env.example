# --- NVIDIA NIM (primary LLM provider) ---
# Get your API key from: https://build.nvidia.com/
# Free tier is 40 RPM; nim_client throttles to stay under it.
NVIDIA_NIM_API_KEY=nvapi-your-key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Telegram (delivery + failure alerts) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- Reddit (retail sentiment + engagement scoring) ---
# Unauthenticated reddit.com/*.json returns 403, so without these every Reddit
# source is skipped and engagement scores never exceed 400.
# Register a "script" app at https://www.reddit.com/prefs/apps
# client_id is the unlabeled ~14-char string shown under the app name.
REDDIT_CLIENT_ID=your-client-id
REDDIT_CLIENT_SECRET=your-client-secret
REDDIT_USER_AGENT=windows:worldpulse:1.0 (by /u/your-reddit-username)
# Without OAuth, Reddit is read via Atom feeds, which rate-limit to ~10 req/min
# and add ~6 min to a run. Set false to skip Reddit and rely on Google News.
# USE_REDDIT_RSS=true

# --- Optional extras ---
PERPLEXITY_API_KEY=pplx-your-key

# --- Feature toggles (defaults shown) ---
# USE_DYNAMIC_TOPICS=true    # fetch trending headlines instead of static DAILY_TOPICS
# HUMANIZE=false             # run the humanizer pass and save both versions
# POST_SUBSTACK=false        # auto-publish articles as Substack drafts
# POST_X=false               # auto-post a thread to X
